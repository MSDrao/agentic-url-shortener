   "design": [
    {
     "name": "design",
     "version": 1,
     "hash": "5270bc98ff5e0673",
     "producer": "design",
     "attempt": 1,
     "derived_from": [
      "requirements_spec@v1",
      "impact_analysis@v1"
     ],
     "created_at": 1790809194.9966717,
     "content": {
      "title": "Limited-use links (max_clicks)",
      "approach": "Add a nullable links.max_clicks column (migration v2). Enforce the limit in the repository with a single conditional INSERT ... SELECT so check-and-record is atomic. The service maps 'not recorded' to 410 Gone (same semantics as expiry). The API contract change is additive: an optional request field and two nullable response fields, so existing clients are unaffected.",
      "api_changes": [
       "POST /api/v1/links: optional max_clicks (1..1,000,000)",
       "GET /api/v1/links/{code} and POST response: + max_clicks, remaining_clicks (nullable)",
       "GET /{code}: 410 when the click limit is reached"
      ],
      "schema_changes": [
       {
        "table": "links",
        "column": "max_clicks",
        "change": "add nullable INTEGER (migration v2)"
       }
      ],
      "data_handling": {
       "personal_data": []
      },
      "tasks": [
       {
        "id": "T1",
        "title": "Migration v2: nullable links.max_clicks",
        "deps": [],
        "satisfies": [
         "AC6"
        ],
        "files": [
         "shortener/db.py"
        ]
       },
       {
        "id": "T2",
        "title": "Model + repository: persist max_clicks, atomic record_click_if_allowed",
        "deps": [
         "T1"
        ],
        "satisfies": [
         "AC5"
        ],
        "files": [
         "shortener/models.py",
         "shortener/repository.py"
        ]
       },
       {
        "id": "T3",
        "title": "Service: validate range, enforce limit (410), remaining_clicks",
        "deps": [
         "T2"
        ],
        "satisfies": [
         "AC2",
         "AC3"
        ],
        "files": [
         "shortener/service.py"
        ]
       },
       {
        "id": "T4",
        "title": "API contract: request/response fields",
        "deps": [
         "T3"
        ],
        "satisfies": [
         "AC1",
         "AC3",
         "AC4"
        ],
        "files": [
         "shortener/schemas.py",
         "shortener/api.py"
        ]
       },
       {
        "id": "T5",
        "title": "Tests written from the ACs (test-first, parallel with T2)",
        "deps": [
         "T1"
        ],
        "satisfies": [
         "AC1",
         "AC2",
         "AC3",
         "AC4",
         "AC5",
         "AC6"
        ],
        "files": [
         "tests/test_max_clicks.py"
        ]
       }
      ],
      "alternatives_considered": [
       {
        "option": "Limit enforcement",
        "decision": "Single conditional INSERT ... SELECT ... WHERE count < max_clicks",
        "why": "Check-then-act in application code races under concurrency; one statement is atomic under SQLite's single writer and maps to a row lock / counter column on Postgres.",
        "rejected": [
         "Read count then insert (overshoots under concurrency)",
         "Denormalized counter column (faster at scale; needs backfill and dual-write)"
        ]
       },
       {
        "option": "Response when exhausted",
        "decision": "410 Gone",
        "why": "Same semantics as expiry, which clients already handle.",
        "rejected": [
         "404 (hides that the link existed)",
         "Redirect to a landing page (needs product input)"
        ]
       },
       {
        "option": "remaining_clicks source",
        "decision": "Derived on read via COUNT(*) over the (link_id, clicked_at) index",
        "why": "No second source of truth to keep consistent.",
        "rejected": [
         "Stored counter"
        ]
       }
      ],
      "risks": [
       {
        "risk": "COUNT(*) per redirect on very hot limited links",
        "likelihood": "low",
        "impact": "medium",
        "mitigation": "covered by index; switch to counter column if redirect p95 regresses"
       },
       {
        "risk": "Old code (after rollback) ignores limits on links created with max_clicks",
        "likelihood": "low",
        "impact": "medium",
        "mitigation": "documented in rollback plan; notify marketing on rollback"
       },
       {
        "risk": "Clients with strict response schemas see two new fields",
        "likelihood": "low",
        "impact": "low",
        "mitigation": "fields are additive and nullable"
       }
      ],
      "rollback_plan": "Redeploy the previous version; migration v2 only adds a nullable column, so v1 code runs unchanged on the v2 schema and no down-migration is needed. While rolled back, limited links behave as unlimited.",
      "changelog": [
       "Add optional `max_clicks` to link creation; exhausted links return 410 Gone",
       "Link metadata includes `max_clicks` and `remaining_clicks`",
       "DB migration v2: nullable `links.max_clicks`"
      ],
