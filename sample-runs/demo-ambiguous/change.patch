+"""Tests for destination denylisting and privacy-preserving visitor analytics."""
+
+from __future__ import annotations
+
+from datetime import timedelta
+
+import pytest
+from fastapi.testclient import TestClient
+
+from shortener.api import create_app
+from shortener.config import Settings
+from shortener.service import LinkService, visitor_hash
+from shortener.validation import is_blocked_domain
+
+BLOCKED = frozenset({"evil.test", "phish.example"})
+
+
+@pytest.fixture
+def safe_settings(tmp_path) -> Settings:
+    return Settings(
+        database_path=str(tmp_path / "safe.db"),
+        base_url="https://sho.rt",
+        rate_limit_per_minute=1000,
+        blocked_domains=BLOCKED,
+        visitor_hash_secret="unit-test",
+        visitor_retention_days=30,
+    )
+
+
+@pytest.fixture
+def safe_service(repo, safe_settings, clock) -> LinkService:
+    return LinkService(repo, safe_settings, clock=clock)
+
+
+@pytest.fixture
+def safe_client(safe_settings, safe_service) -> TestClient:
+    return TestClient(create_app(safe_settings, service=safe_service), follow_redirects=False)
+
+
+@pytest.mark.parametrize("url", ["https://evil.test/x", "https://login.evil.test/", "http://PHISH.example./a"])
+def test_http_denylisted_destination_rejected(safe_client, url):
+    resp = safe_client.post("/api/v1/links", json={"url": url})
+    assert resp.status_code == 422
+    assert "blocked" in resp.json()["detail"]
+
+
+def test_denylist_matches_parent_domains_only():
+    assert is_blocked_domain("a.b.evil.test", BLOCKED)
+    assert not is_blocked_domain("notevil.test", BLOCKED)
+    assert not is_blocked_domain("evil.test.example.com", BLOCKED)
+
+
+def test_http_unique_visitors_in_stats(safe_client):
+    code = safe_client.post("/api/v1/links", json={"url": "https://example.com"}).json()["code"]
+    for ua in ("browser-a", "browser-a", "browser-b"):
+        assert safe_client.get(f"/{code}", headers={"User-Agent": ua}).status_code == 307
+    stats = safe_client.get(f"/api/v1/links/{code}/stats").json()
+    assert stats["total_clicks"] == 3
+    assert stats["unique_visitors"] == 2
+
+
+def test_raw_ip_never_persisted(safe_service, db):
+    link = safe_service.create_link("https://example.com")
+    safe_service.resolve(link.code, user_agent="ua", client_ip="203.0.113.77")
+    with db.read() as conn:
+        cols = [r["name"] for r in conn.execute("PRAGMA table_info(clicks)")]
+        rows = [tuple(r) for r in conn.execute("SELECT * FROM clicks")]
+    assert not {"ip", "ip_address", "client_ip"} & set(cols)
+    assert all("203.0.113.77" not in str(v) for row in rows for v in row)
+
+
+def test_visitor_hash_is_keyed_and_rotates_daily():
+    a = visitor_hash("k1", "2026-01-15", "203.0.113.7", "ua")
+    assert a == visitor_hash("k1", "2026-01-15", "203.0.113.7", "ua")
+    assert a != visitor_hash("k2", "2026-01-15", "203.0.113.7", "ua")   # keyed
+    assert a != visitor_hash("k1", "2026-01-16", "203.0.113.7", "ua")   # daily rotation
+    assert visitor_hash("k1", "2026-01-15", None, "ua") is None
+
+
+def test_visitor_hashes_purged_after_retention(safe_service, repo, clock):
+    link = safe_service.create_link("https://example.com")
+    safe_service.resolve(link.code, user_agent="ua", client_ip="203.0.113.7")
+    clock.advance(days=31)
+    safe_service.resolve(link.code, user_agent="ua", client_ip="203.0.113.7")
+    assert safe_service.purge_visitor_data() == 1
+    assert repo.stats(link.id).unique_visitors == 1   # only the recent hash remains
+    assert repo.stats(link.id).total_clicks == 2      # click counts are kept
+
+
+def test_http_existing_link_blocked_after_denylisting(repo, clock, tmp_path):
+    open_settings = Settings(database_path=str(tmp_path / "x.db"), rate_limit_per_minute=1000)
+    link = LinkService(repo, open_settings, clock=clock).create_link("https://login.evil.test/")
+    strict = Settings(database_path=str(tmp_path / "x.db"), blocked_domains=BLOCKED, visitor_hash_secret="unit-test")
+    client = TestClient(create_app(strict, service=LinkService(repo, strict, clock=clock)), follow_redirects=False)
+    resp = client.get(f"/{link.code}")
+    assert resp.status_code == 410
+    assert "blocked" in resp.json()["detail"]
+    assert repo.count_clicks(link.id) == 0
