+def visitor_hash(secret: str, day: str, client_ip: str | None, user_agent: str | None) -> str | None:
+    """Pseudonymous visitor id: keyed HMAC that rotates daily. The raw IP is never stored,
+    and without the key the hash cannot be reversed or linked across days."""
+    if not client_ip:
+        return None
+    msg = f"{day}|{client_ip}|{user_agent or ''}".encode()
+    return hmac.new(secret.encode(), msg, hashlib.sha256).hexdigest()[:32]
 
 
