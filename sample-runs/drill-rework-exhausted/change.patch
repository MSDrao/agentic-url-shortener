+"""Tests for limited-use links (max_clicks)."""
+
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+from shortener.db import MIGRATIONS, Database
+from shortener.repository import LinkRepository
+
+
+def _create(client, **body):
+    body.setdefault("url", "https://example.com/promo")
+    return client.post("/api/v1/links", json=body)
+
+
+def test_http_create_with_max_clicks_shows_remaining(client):
+    created = _create(client, max_clicks=3)
+    assert created.status_code == 201
+    assert created.json()["max_clicks"] == 3
+    assert created.json()["remaining_clicks"] == 3
+    code = created.json()["code"]
+    client.get(f"/{code}")
+    meta = client.get(f"/api/v1/links/{code}").json()
+    assert meta["max_clicks"] == 3 and meta["remaining_clicks"] == 2
+
+
+def test_http_limit_reached_returns_410(client):
+    code = _create(client, max_clicks=2).json()["code"]
+    assert client.get(f"/{code}").status_code == 307
+    assert client.get(f"/{code}").status_code == 307
+    blocked = client.get(f"/{code}")
+    assert blocked.status_code == 410
+    assert "click limit" in blocked.json()["detail"]
+    assert client.get(f"/api/v1/links/{code}/stats").json()["total_clicks"] == 2
+    assert client.get(f"/api/v1/links/{code}").json()["remaining_clicks"] == 0
+
+
+@pytest.mark.parametrize("value", [0, -1, 1_000_001, "ten"])
+def test_http_invalid_max_clicks_rejected(client, value):
+    assert _create(client, max_clicks=value).status_code == 422
+
+
+def test_http_unlimited_links_unchanged(client):
+    created = _create(client)
+    assert created.status_code == 201
+    assert created.json()["max_clicks"] is None
+    assert created.json()["remaining_clicks"] is None
+    code = created.json()["code"]
+    for _ in range(5):
+        assert client.get(f"/{code}").status_code == 307
+
+
+def test_service_rejects_out_of_range_max_clicks(service):
+    from shortener.errors import InvalidInput
+
+    with pytest.raises(InvalidInput):
+        service.create_link("https://example.com", max_clicks=0)
+
+
+def test_repository_limit_is_atomic(repo, clock):
+    link = repo.create("race001", "https://example.com", clock.now, None, max_clicks=5)
+    results: list[bool] = []
+    lock = threading.Lock()
+
+    def click():
+        ok = repo.record_click_if_allowed(link.id, clock.now, None, None)
+        with lock:
+            results.append(ok)
+
+    threads = [threading.Thread(target=click) for _ in range(20)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert sum(results) == 5
+    assert repo.count_clicks(link.id) == 5
+
+
+def test_migration_upgrades_existing_v1_database(tmp_path, monkeypatch):
+    import shortener.db as dbmod
+
+    path = str(tmp_path / "v1.db")
+    monkeypatch.setattr(dbmod, "MIGRATIONS", MIGRATIONS[:1])
+    old = Database(path)
+    assert old.migrate() == 1
+    with old.write() as conn:
+        conn.execute(
+            "INSERT INTO links (code, target_url, created_at) "
+            "VALUES ('legacy1', 'https://a.test', '2026-01-01T00:00:00+00:00')"
+        )
+    monkeypatch.undo()
+    new = Database(path)
+    assert new.migrate() == 2
+    link = LinkRepository(new).get_by_code("legacy1")
+    assert link is not None and link.max_clicks is None
