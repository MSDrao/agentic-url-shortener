        ]
       }
      ],
      "alternatives_considered": [
       {
        "option": "Redirect status code",
        "decision": "307 Temporary Redirect with Cache-Control max-age=0",
        "why": "301 is cached by browsers, so repeat clicks bypass the service and analytics undercount; 307 also preserves the method.",
        "rejected": [
         "301 Moved Permanently (cached, breaks analytics)",
