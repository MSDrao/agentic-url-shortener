+"""Tests for limited-use links (max_clicks)."""
+
+from __future__ import annotations
+
+import sqlite3
+import threading
+
+import pytest
+
+from shortener.db import MIGRATIONS, Database
+from shortener.errors import InvalidInput
+from shortener.repository import LinkRepository
+
+URL = "https://example.com/page"
+
+
+def _create(client, **extra):
+    return client.post("/api/v1/links", json={"url": URL, **extra})
+
+
+def test_http_create_with_max_clicks_shows_remaining(client):
+    r = _create(client, max_clicks=3)
+    assert r.status_code == 201
+    body = r.json()
+    assert body["max_clicks"] == 3 and body["remaining_clicks"] == 3
+    code = body["code"]
+    assert client.get(f"/{code}").status_code == 307
+    link = client.get(f"/api/v1/links/{code}").json()
+    assert link["max_clicks"] == 3 and link["remaining_clicks"] == 2
+    stats = client.get(f"/api/v1/links/{code}/stats").json()
+    assert stats["max_clicks"] == 3 and stats["remaining_clicks"] == 2
+    assert stats["total_clicks"] == 1
+
+
+def test_http_limit_reached_returns_410(client):
+    code = _create(client, max_clicks=2).json()["code"]
+    assert client.get(f"/{code}").status_code == 307
+    assert client.get(f"/{code}").status_code == 307
+    for _ in range(3):
+        r = client.get(f"/{code}")
+        assert r.status_code == 410
+        assert "detail" in r.json()
+    stats = client.get(f"/api/v1/links/{code}/stats").json()
+    assert stats["total_clicks"] == 2
+    assert stats["remaining_clicks"] == 0
+
+
+def test_http_unknown_code_still_404(client):
+    assert client.get("/nope1234").status_code == 404
+
+
+@pytest.mark.parametrize("bad", [0, -1, 1_000_001, True, 1.5, "5"])
+def test_http_invalid_max_clicks_rejected(client, bad):
+    r = _create(client, max_clicks=bad, custom_alias="bad-alias1")
+    assert r.status_code == 422
+    assert client.get("/api/v1/links/bad-alias1").status_code == 404
+
+
+@pytest.mark.parametrize("bad", [0, -1, 1_000_001, True, 1.5, "5"])
+def test_service_rejects_out_of_range_max_clicks(service, bad):
+    with pytest.raises(InvalidInput):
+        service.create_link(URL, max_clicks=bad)
+
+
+def test_http_unlimited_links_unchanged(client):
+    body = _create(client).json()
+    assert body["max_clicks"] is None and body["remaining_clicks"] is None
+    code = body["code"]
+    for _ in range(5):
+        assert client.get(f"/{code}").status_code == 307
+    link = client.get(f"/api/v1/links/{code}").json()
+    assert link["max_clicks"] is None and link["remaining_clicks"] is None
+    assert client.get(f"/api/v1/links/{code}/stats").json()["total_clicks"] == 5
+
+
+def test_repository_limit_is_atomic(repo, clock):
+    link = repo.create("atomic1", "https://a.test", clock.now, None, 5)
+    results: list[bool] = []
+    lock = threading.Lock()
+    barrier = threading.Barrier(20)
+
+    def worker():
+        barrier.wait()
+        ok = repo.record_click_if_allowed(link.id, clock.now, None, None)
+        with lock:
+            results.append(ok)
+
+    threads = [threading.Thread(target=worker) for _ in range(20)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert sum(results) == 5
+    assert repo.count_clicks(link.id) == 5
+
+
+def test_migration_upgrades_existing_v1_database(tmp_path):
+    path = str(tmp_path / "v1.db")
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)")
+    for sql in MIGRATIONS[0][1]:
+        conn.execute(sql)
+    conn.execute("INSERT INTO schema_version (version) VALUES (1)")
+    conn.execute(
+        "INSERT INTO links (code, target_url, created_at) VALUES (?, ?, ?)",
+        ("old1234", "https://old.test", "2026-01-01T00:00:00+00:00"),
+    )
+    conn.commit()
+    conn.close()
+
+    db = Database(path)
+    latest = max(v for v, _ in MIGRATIONS)
+    assert db.migrate() == latest
+    assert db.migrate() == latest  # repeat is safe
+    link = LinkRepository(db).get_by_code("old1234")
+    assert link is not None and link.max_clicks is None
